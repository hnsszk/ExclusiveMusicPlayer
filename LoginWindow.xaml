<Window x:Class="ExclusiveMusicPlayer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录网易云音乐"
        Width="340"
        Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="扫码登录网易云音乐"
                   HorizontalAlignment="Center"
                   Foreground="#202124"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="请使用手机版网易云音乐 App 扫描下方二维码"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#5F6368"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <Border Width="232"
                Height="232"
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                Background="White"
                BorderBrush="#D8DADF"
                BorderThickness="1">
            <Image x:Name="QrImage"
                   Stretch="Fill"
                   Source="{Binding QrImageSource}" />
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                   Margin="0,14,0,0"
                   Text="{Binding StatusText}"
                   HorizontalAlignment="Center"
                   Foreground="#5F6368"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,16,0,0"
                   Text="二维码过期后自动刷新，请保持窗口打开"
                   HorizontalAlignment="Center"
                   Foreground="#9AA3AF"
                   FontSize="11" />

        <Button Content="取消"
                Margin="0,14,0,0"
                Padding="14,8"
                Width="96"
                HorizontalAlignment="Center"
                IsCancel="True" />
    </StackPanel>
</Window>
