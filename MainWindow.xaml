<Window x:Class="ExclusiveMusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ExclusiveMusicPlayer"
        xmlns:vm="clr-namespace:ExclusiveMusicPlayer.ViewModels"
        Title="ExclusiveMusicPlayer - WASAPI 独占播放器"
        Width="1080"
        Height="680"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="10"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 收藏窗列表/空提示的可见性转换。 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- 枚举匹配转换（RadioButton 绑定枚举属性的 IsChecked）。 -->
        <local:EnumMatchConverter x:Key="EnumMatchConverter" />
        <Style x:Key="NavButtonStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E7E9EC" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E4533C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#E4533C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#E4533C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D6492F" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D6492F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C2442D" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C2442D" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3D434D" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 红心按钮：心形轮廓+四角。Fill 随喜欢状态切换（未喜欢=底栏次级灰，已喜欢=主题红）。 -->
        <Style x:Key="HeartButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3D434D" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 收藏按钮（添加音乐）：透明底、圆角、hover 提亮，与红心一致的尺寸 -->
        <Style x:Key="CollectButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3D434D" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 去掉焦点虚线框（切回窗口时围绕点击位置的灰色虚线） -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F2F4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FBE7E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角搜索框样式 -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#CCD8DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#E4533C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索框样式：半透明、圆角、左侧放大镜图标 -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="Background" Value="#CCFFFFFF" />
            <Setter Property="BorderBrush" Value="#B8D8DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#9AA3AF"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="30,0,10,0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#E4533C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首页卡片按钮：透明背景、圆角、hover 反馈 -->
        <Style x:Key="HomeCardButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F6F7F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E9EBEF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索类型选择项：横排小标签，选中橙色高亮 -->
        <Style x:Key="SearchTypeItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F2F4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E4533C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 音质下拉框：深色风格，与底部控制栏一致 -->
        <Style x:Key="BottomBarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="104" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#30353B" />
            <Setter Property="BorderBrush" Value="#3C424B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#30353B"
                                          BorderBrush="#3C424B"
                                          BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,26,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center" />
                                                <Path HorizontalAlignment="Right"
                                                      Margin="0,0,9,0"
                                                      VerticalAlignment="Center"
                                                      Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Fill="#9AA3AF" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Margin="10,0,26,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="12"
                                       Text="{Binding PreferredQuality.Display}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Placement="Bottom">
                                <Border Background="#30353B"
                                        BorderBrush="#3C424B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D434D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 设置页浅色下拉框：白色卡片内使用，与 BottomBarComboBoxStyle 的深色风格对应 -->
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,26,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center" />
                                                <Path HorizontalAlignment="Right"
                                                      Margin="0,0,9,0"
                                                      VerticalAlignment="Center"
                                                      Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Fill="#9AA3AF" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Placement="Bottom">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#C9CDD4" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E4533C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 设置页开关（ToggleButton 自定义样式）：轨道 + 圆钮，开启红色，关闭灰色。 -->
        <Style x:Key="SettingsToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="40"
                                Height="22"
                                CornerRadius="11"
                                Background="#C9CDD4"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="#FFFFFF"
                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#E4533C" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全局窄圆角滚动条样式（隐式，所有 ScrollBar 生效） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="false">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="false" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#C0C4CC"
                                                        CornerRadius="3"
                                                        Margin="0,1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#A8ADB5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="false" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌曲行悬停播放三角按钮：独立在缩略图左侧，单击即播放 -->
        <Style x:Key="HoverPlayButtonStyle" TargetType="Button">
            <!-- 触发框：隐形小正方形（28×28），只要鼠标落在这个范围内都能点中三角形 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 隐形触发框：透明底铺满整个按钮（Transparent 在 WPF 中参与命中测试），
                                 让整个 28×28 正方形范围内都能点中三角形 -->
                            <Border Background="Transparent" />
                            <!-- 浅灰半透明播放三角（14px，居中在触发框内）；hover 时稍微加深，按下再加深 -->
                            <Path x:Name="Tri"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="#C6CCD4"
                                  Data="M 0,0 L 0,12 L 9.6,6 Z" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tri" Property="Fill" Value="#9AA3AF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tri" Property="Fill" Value="#7A838F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌曲右键菜单：深色主题。ContextMenu 圆角面板 + 自定义 MenuItem 模板，
             图标列等宽对齐、悬停整行变主题灰，去掉默认浅色方块与复选列。 -->
        <Style x:Key="SongContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#E7E9EC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1F242B"
                                BorderBrush="#3C424B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SongMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E7E9EC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,1">
                            <StackPanel Orientation="Horizontal">
                                <!-- 图标列等宽 18px，与文字间距固定，三菜单项图标对齐 -->
                                <ContentPresenter ContentSource="Icon"
                                                  Width="18"
                                                  Height="18"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0" />
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全局应用到所有 ScrollViewer -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- 圆角轨道 + 圆形 Thumb 的 Slider 样式（进度条 / 音量） -->
        <Style x:Key="RoundedSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E4533C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   Focusable="false">
                                <!-- 已填充部分：橙色圆角条 -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Focusable="false">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#E4533C"
                                                        CornerRadius="4"
                                                        Height="6" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <!-- 未填充部分：深灰圆角条 -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="false">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#3C424B"
                                                        CornerRadius="4"
                                                        Height="6" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <!-- 圆形 Thumb -->
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbCircle"
                                                         Width="12"
                                                         Height="12"
                                                         Fill="#E4533C" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="14" />
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="14" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="14" />
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="14" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootChrome"
            CornerRadius="10"
            Background="#F3F4F6"
            ClipToBounds="True"
            PreviewMouseLeftButtonDown="WindowTopArea_PreviewMouseLeftButtonDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#22272E">
                <StackPanel>
                    <!-- 顶部 logo 区：可拖动窗口，双击最大化/还原 -->
                    <StackPanel Margin="0,0,0,0"
                                Background="Transparent"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Margin="18,24,18,6"
                                   Text="ExclusiveMusicPlayer"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None" />
                        <Viewbox Width="160"
                                 Height="16"
                                 HorizontalAlignment="Left"
                                 Margin="18,0,18,18">
                            <TextBlock Text="支持网易云音乐WASAPI独占播放"
                                       Foreground="#9AA3AF"
                                       FontSize="12"
                                       TextWrapping="NoWrap" />
                        </Viewbox>
                    </StackPanel>

                    <ListBox x:Name="NavigationList"
                             SelectionChanged="NavigationList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavButtonStyle}">
                        <ListBoxItem Content="首页" />
                        <ListBoxItem Content="搜索" />
                        <ListBoxItem Content="喜欢的音乐" />
                        <ListBoxItem Content="我的歌单" />
                        <!-- 隐藏导航项：点进歌单后的歌曲列表页，侧边栏不显示条目 -->
                        <ListBoxItem Content="歌曲列表" Visibility="Collapsed" />
                        <ListBoxItem Content="设置" />
                    </ListBox>

                    <TextBlock Margin="18,26,18,6"
                               Text="输出模式"
                               Foreground="#9AA3AF"
                               FontSize="12" />
                    <Border Margin="14,0,14,0"
                            Padding="10,8"
                            Background="#2E343C"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputModeText}"
                                       Foreground="#7EE787"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding OutputDeviceText}"
                                       Foreground="#9AA3AF"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- 登录账号卡片 -->
                    <Border Margin="14,16,14,0"
                            Padding="10,8"
                            Background="#2E343C"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="账号"
                                       Foreground="#9AA3AF"
                                       FontSize="12" />
                            <TextBlock x:Name="AccountNameText"
                                       Margin="0,4,0,0"
                                       Text="{Binding LoginState.Nickname, FallbackValue=未登录}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="LoginButton"
                                    Content="登录"
                                    Margin="0,8,0,0"
                                    Padding="6,5"
                                    Background="#3D434D"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="LoginButton_Click" />
                            <Button x:Name="LogoutButton"
                                    Content="注销"
                                    Visibility="Collapsed"
                                    Margin="0,8,0,0"
                                    Padding="6,5"
                                    Background="#3D434D"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="LogoutButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="26,18">
                <Grid.RowDefinitions>
                    <!-- 三行：右上角窗口控制按钮 / 页面标题 header / 内容列表。
                         header 独立一行，任何窗口宽度都不会与最小化/最大化/关闭重叠。 -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 窗口控制按钮（右上角，与页面标题同一行） -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <!-- 最小化 -->
                    <Button x:Name="MinimizeButton"
                            Width="42"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#30353B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#9AA3AF"
                                   FontSize="12" />
                    </Button>
                    <!-- 最大化 / 还原 -->
                    <Button x:Name="MaximizeButton"
                            Width="42"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MaximizeButton_Click"
                            ToolTip="最大化">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#30353B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="MaximizeIcon"
                                   Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#9AA3AF"
                                   FontSize="12" />
                    </Button>
                    <!-- 关闭 -->
                    <Button x:Name="CloseButton"
                            Width="42"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="关闭">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#E81123" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#9AA3AF"
                                   FontSize="12" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            x:Name="SearchHeader"
                            Margin="0,0,0,16"
                            Orientation="Horizontal">
                    <!-- 返回按钮：回到首页 -->
                    <Button x:Name="BackButton"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BackButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#F1F2F4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#202124"
                                   VerticalAlignment="Center" />
                    </Button>

                    <TextBlock MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Text="搜索"
                               VerticalAlignment="Center"
                               Foreground="#202124"
                               FontSize="22"
                               FontWeight="SemiBold" />

                    <TextBox Width="300"
                             Height="36"
                             Margin="16,0,0,0"
                             Style="{StaticResource SearchBoxStyle}"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown" />

                    <!-- 搜索类型选择器：歌曲 / 歌单 / 专辑 / 歌手 -->
                    <ListBox x:Name="SearchTypeList"
                             Margin="14,0,0,0"
                             ItemsSource="{Binding SearchTypeOptions}"
                             DisplayMemberPath="Display"
                             SelectedItem="{Binding CurrentSearchTypeOption, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SearchTypeItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Button x:Name="PlayAllSongsButton"
                            Content="播放全部"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="14,0,0,0"
                            Click="PlayAllSongs_Click" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            x:Name="LikedHeader"
                            Visibility="Collapsed"
                            Margin="0,0,0,16"
                            Orientation="Horizontal">
                    <Button x:Name="LikedBackButton"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BackButton_Click"
                            ToolTip="返回首页">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#F1F2F4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#202124"
                                   VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Margin="0,0,18,0"
                               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                               Text="喜欢的音乐"
                               VerticalAlignment="Center"
                               Foreground="#202124"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <Button Content="播放全部"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="PlayAllLiked_Click" />
                    <StackPanel Margin="20,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="在列表中搜索"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9CA3AF"
                                   FontSize="12" />
                        <TextBox Style="{StaticResource SearchBoxStyle}"
                                 Width="220"
                                 Height="32"
                                 Text="{Binding ListFilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            x:Name="MyPlaylistHeader"
                            Visibility="Collapsed"
                            Margin="0,0,0,16"
                            Orientation="Horizontal">
                    <TextBlock MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Text="我的歌单"
                               VerticalAlignment="Center"
                               Foreground="#202124"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="16,0,0,0"
                               Text="左右分别为我创建和收藏的歌单"
                               VerticalAlignment="Center"
                               Foreground="#9CA3AF"
                               FontSize="12" />
                </StackPanel>

                <!-- 歌曲列表页头部（点进歌单）：返回 + 标题 + 播放全部 + 列表内搜索。
                     无全站搜索框/类型选择器，样式与「喜欢的音乐」统一。 -->
                <StackPanel Grid.Row="1"
                            x:Name="TrackListHeader"
                            Visibility="Collapsed"
                            Margin="0,0,0,16"
                            Orientation="Horizontal">
                    <Button x:Name="TrackBackButton"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="TrackBackButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#F1F2F4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#202124"
                                   VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Text="{Binding TrackListTitle}"
                               VerticalAlignment="Center"
                               Foreground="#202124"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="240"
                               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                    <Button Content="播放全部"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="16,0,0,0"
                            Click="PlayAllSongs_Click" />
                    <StackPanel Margin="20,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="在列表中搜索"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9CA3AF"
                                   FontSize="12" />
                        <TextBox Style="{StaticResource SearchBoxStyle}"
                                 Width="220"
                                 Height="32"
                                 Text="{Binding ListFilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <!-- 歌曲列表 -->
                <Grid Grid.Row="2" x:Name="SongListContainer">
                    <ListBox x:Name="SongList"
                             ItemsSource="{Binding DisplaySongs}"
                             SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                             MouseDoubleClick="SongList_MouseDoubleClick"
                             ContextMenuOpening="SongList_ContextMenuOpening"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent">
                        <!-- 歌曲行右键菜单：播放 / 收藏到歌单 / 删除。
                             挂在 ListBox 上（ContextMenu 不在可视树内，按行挂无法绑 DataContext）；
                             右键目标歌曲在 SongList_ContextMenuOpening 里设置，
                             删除项可见性绑 VM 的 CanDeleteFromCurrentList（bool→Visibility 需显式转换器）。 -->
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource SongContextMenuStyle}">
                                <MenuItem Header="播放"
                                          Style="{StaticResource SongMenuItemStyle}"
                                          Click="SongContextMenu_Play_Click">
                                    <MenuItem.Icon>
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Fill="#9AA3AF"
                                              Data="M 0,0 L 0,16 L 12.8,8 Z" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="收藏到歌单"
                                          Style="{StaticResource SongMenuItemStyle}"
                                          Click="SongContextMenu_Collect_Click">
                                    <MenuItem.Icon>
                                        <!-- 与底部「收藏到歌单」按钮同款图标（添加音乐 SVG，8 段路径合并）。 -->
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Fill="#9AA3AF"
