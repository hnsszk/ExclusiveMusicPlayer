                        </Button>
                        <!-- 停止：实心方块 -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="StopButton_Click"
                                ToolTip="停止">
                            <Path Width="12"
                                  Height="12"
                                  Fill="#9AA3AF"
                                  Stretch="Uniform"
                                  Data="M 0,0 H 12 V 12 H 0 Z" />
                        </Button>
                        <ComboBox Style="{StaticResource BottomBarComboBoxStyle}"
                                  Margin="0,0,10,0"
                                  ItemsSource="{Binding QualityOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedItem="{Binding PreferredQuality}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="🔊"
                                   Foreground="#9AA3AF"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Margin="0,0,6,0" />
                        <Slider Width="100"
                                Style="{StaticResource RoundedSliderStyle}"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 收藏到歌单弹窗：点击底部「收藏」按钮弹出，列出我创建的歌单，单击即收藏 -->
        <!-- 居中弹窗：全窗口遮罩（变暗）+ 居中长方形小窗，显示我创建的歌单（左缩略图右名称），
             悬停歌单变灰反馈，点击歌单即收藏并关闭。遮罩覆盖全窗口（含底部状态栏），点空白处关闭。 -->
        <Grid x:Name="CollectDialogOverlay"
              Panel.ZIndex="99"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#8C000000"
              MouseLeftButtonDown="CollectDialogOverlay_MouseLeftButtonDown">
            <Border x:Name="CollectDialogCard"
                    Width="300"
                    Background="#1F242B"
                    BorderBrush="#3C424B"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="16,14,10,10">
                        <TextBlock Text="收藏到歌单"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseCollectDialog_Click"
                                ToolTip="关闭">
                            <TextBlock Text="✕"
                                       Foreground="#9AA3AF"
                                       FontSize="13"
                                       TextOptions.TextFormattingMode="Ideal"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding CollectPopupSongText}"
                               Foreground="#9AA3AF"
                               FontSize="11"
                               Margin="16,0,16,10"
                               TextTrimming="CharacterEllipsis" />
                    <Border Height="1" Background="#3C424B" />
                    <ListBox x:Name="CollectDialogList"
                             Margin="10,8,10,12"
                             MaxHeight="280"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding CreatedPlaylistsForCollect}"
                             Visibility="{Binding HasCollectPlaylists, Converter={StaticResource BooleanToVisibilityConverter}}"
                             SelectionChanged="CollectDialogList_SelectionChanged">
                        <!-- 弹窗内深色列表项样式：覆盖全局隐式浅色 ListBoxItem 样式，
                             悬停变灰、选中变主题红。 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Margin" Value="2,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#2E343C" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#E4533C" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="52" Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="38"
                                          Height="38">
                                        <Border Background="#2E343C"
                                                CornerRadius="7" />
                                        <Border CornerRadius="7">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding CoverUrl}"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding TrackCountText}"
                                                   Foreground="#9AA3AF"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding CollectNoPlaylistsText}"
                               Foreground="#9AA3AF"
                               FontSize="12.5"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="16,24"
                               Visibility="{Binding ShowCollectEmptyText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
