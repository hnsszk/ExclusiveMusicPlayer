                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="删除"
                                          Style="{StaticResource SongMenuItemStyle}"
                                          Click="SongContextMenu_Delete_Click"
                                          Visibility="{Binding CanDeleteFromCurrentList,
                                                               Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuItem.Icon>
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Fill="#9AA3AF"
                                              Data="M864 256H736v-80c0-35.3-28.7-64-64-64H352c-35.3 0-64 28.7-64 64v80H160c-17.7 0-32 14.3-32 32s14.3 32 32 32h32v416c0 70.6 57.4 128 128 128h384c70.6 0 128-57.4 128-128V320h32c17.7 0 32-14.3 32-32s-14.3-32-32-32zM352 192h320v64H352v-64z" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="64" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <!-- 播放三角触发框列；标题列与缩略图之间留 10px 间距，避免文字贴图 -->
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                <!-- 悬停播放三角：独立一列，放在缩略图左侧，与缩略图留 6px 间距 -->
                                <Button Grid.Column="0"
                                        x:Name="HoverPlayButton"
                                        Style="{StaticResource HoverPlayButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Visibility="Collapsed"
                                        Click="SongRowPlayButton_Click"
                                        Tag="{Binding}" />
                                <!-- 歌曲缩略图：双层 Border + ImageBrush 实现圆角裁剪（同底部播放栏效果）。
                                     外层灰色底 + 内层圆角 Border 用 ImageBrush 铺封面，Image 本体不圆角也不溢出。 -->
                                <Grid Grid.Column="1"
                                      Width="48"
                                      Height="48">
                                    <Border Background="#F0E4DF"
                                            CornerRadius="8" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverUrl}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#202124"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding ArtistNames}"
                                               Foreground="#6B7280"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding DurationText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#9CA3AF" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- 鼠标悬停该行时显示播放三角，移开后消失 -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <Setter TargetName="HoverPlayButton"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>

                <ListBox Grid.Row="2"
                         x:Name="PlaylistList"
                         Visibility="Collapsed"
                         ItemsSource="{Binding Playlists}"
                         MouseDoubleClick="PlaylistList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1"
                                      Width="48"
                                      Height="48">
                                    <Border Background="#F0E4DF"
                                            CornerRadius="8" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverUrl}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#202124"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding CreatorName}"
                                               Foreground="#6B7280"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding TrackCountText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#9CA3AF" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 专辑搜索结果 -->
                <ListBox Grid.Row="2"
                         x:Name="AlbumList"
                         Visibility="Collapsed"
                         ItemsSource="{Binding Albums}"
                         MouseDoubleClick="AlbumList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1"
                                      Width="48"
                                      Height="48">
                                    <Border Background="#F0E4DF"
                                            CornerRadius="8" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverUrl}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#202124"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding ArtistName}"
                                               Foreground="#6B7280"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding TrackCountText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#9CA3AF" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 歌手搜索结果 -->
                <ListBox Grid.Row="2"
                         x:Name="ArtistList"
                         Visibility="Collapsed"
                         ItemsSource="{Binding Artists}"
                         MouseDoubleClick="ArtistList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1"
                                      Width="48"
                                      Height="48">
                                    <Border Background="#F0E4DF"
                                            CornerRadius="8" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverUrl}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#202124"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding AlbumCountText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#9CA3AF" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 我的歌单视图：创建 / 收藏 两组 -->
                <!-- 我的歌单视图：左"我创建的"，右"我收藏的"，各列独立滚动，中间淡灰竖线 -->
                <Grid Grid.Row="2"
                      x:Name="MyPlaylistView"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列：我创建的 -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,10"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="我创建的"
                                       Foreground="#5F6368"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CreatedPlaylists}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="CreatedPlaylists_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="72" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="56"
                                              Height="56">
                                            <Border Background="#F0E4DF"
                                                    CornerRadius="10" />
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding CoverUrl}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="#202124"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding CreatorName}"
                                                       Foreground="#6B7280"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TrackCountText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#9CA3AF"
                                                   FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 淡灰柔和竖分隔线 -->
                    <Border Grid.Column="1"
                            Width="1"
                            Margin="0,2"
                            Background="#E5E7EB" />

                    <!-- 右列：我收藏的 -->
                    <Grid Grid.Column="2" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,10"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="我收藏的"
                                       Foreground="#5F6368"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CollectedPlaylists}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="CollectedPlaylists_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="72" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="56"
                                              Height="56">
                                            <Border Background="#F0E4DF"
                                                    CornerRadius="10" />
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding CoverUrl}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="#202124"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding CreatorName}"
                                                       Foreground="#6B7280"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TrackCountText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#9CA3AF"
                                                   FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- 首页视图：标题+搜索 / 大卡片 / 推荐歌单占满剩余 -->
                <Grid Grid.Row="2" x:Name="HomeView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- *：推荐歌单区占满剩余高度，区内 ScrollViewer 滚动，任何窗口高度都能看到全部 -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. 首页标题 + 搜索栏（同一行，间距适当） -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,26"
                                Orientation="Horizontal">
                        <TextBlock MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Text="首页"
                                   VerticalAlignment="Center"
                                   Foreground="#202124"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBox Style="{StaticResource SearchBoxStyle}"
                                 Width="340"
                                 Margin="18,0,0,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding HomeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="HomeSearchBox_KeyDown" />
                    </StackPanel>

                    <!-- 2. 第一栏快捷卡片：我喜欢的音乐 / 今日推荐 / 私人雷达 / 日系 / 欧美。
                         UniformGrid 固定 5 列等宽，任何窗口宽度都排一行不换行，
                         封面随卡片宽度自适应为正方形。 -->
                    <ItemsControl Grid.Row="1"
                                  Margin="0,0,12,0"
                                  ItemsSource="{Binding HomeQuickCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HomeCardButtonStyle}"
                                        Margin="0,0,22,0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top"
                                        Click="HomeQuickCard_Click">
                                    <StackPanel>
                                        <!-- 封面填满卡片宽度（正方形）：Viewbox 等比缩放，宽度=列宽，
                                             高度随列宽自适应，最大化时封面放大、卡片变高，不留空白。 -->
                                        <Viewbox Stretch="Uniform"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Top">
                                            <Grid Width="100" Height="100">
                                                <Border CornerRadius="12" Background="#E4ECEF" />
                                                <Border CornerRadius="12">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding CoverUrl}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#202124"
                                                   Margin="0,8,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 3. 推荐歌单区：占满剩余高度，区内滚动兜底 -->
                    <Grid Grid.Row="2" Margin="0,20,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 标题行：推荐歌单 + 右侧刷新按钮 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="推荐歌单"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#202124"
                                       VerticalAlignment="Center" />
                            <!-- 刷新按钮：Material refresh 环形箭头，点击重新拉取推荐歌单 -->
                            <Button Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="刷新推荐歌单"
                                    Click="RefreshRecommended_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#F1F2F4" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#E9EBEF" />
                                                <Setter TargetName="Root" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="1" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4,7.58 4,12 C 4,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 Z"
                                      Fill="#9AA3AF"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <!-- 推荐歌单列表：固定 6 列，两行卡片。
                             ScrollViewer + UniformGrid（不设 Rows）：卡片高度由自身 Height 决定，
                             不被 UniformGrid 拉伸；窗口太矮时区内滚动兜底，保证两行完整可读。 -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      BorderThickness="0"
                                      Background="Transparent">
                            <ItemsControl ItemsSource="{Binding RecommendedPlaylists}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- 固定 6 列（不设 Rows）：窗口多宽卡片多宽，任何尺寸都不换行 -->
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 封面填满列宽（正方形）：Viewbox 等比缩放，宽度=列宽，
                                             高度随列宽自适应，最大化时封面放大、不留空白。 -->
                                        <Button Style="{StaticResource HomeCardButtonStyle}"
                                                Margin="0,0,10,10"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Top"
                                                Click="RecommendedPlaylistCard_Click">
                                            <StackPanel>
                                                <Viewbox Stretch="Uniform"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Top">
                                                    <Grid Width="96" Height="96">
                                                        <Border CornerRadius="10" Background="#F0E4DF" />
                                                        <Border CornerRadius="10">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding CoverUrl}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12"
                                                           Foreground="#202124"
                                                           Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="32"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding TrackCountText}"
                                                           FontSize="11"
                                                           Foreground="#9CA3AF"
                                                           Margin="0,2,0,0"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 设置页：API 服务 + 音频输出。左导航「设置」进入。
                     排版：标题 + 分组卡片（API 服务 / 音频输出），整页可滚动避免窗口变矮时卡片被裁。 -->
                <Grid Grid.Row="2" x:Name="SettingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,18" Orientation="Horizontal">
                        <TextBlock Text="设置"
                                   VerticalAlignment="Center"
                                   Foreground="#202124"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,12,8"
                                  BorderThickness="0"
                                  Background="Transparent">
                        <StackPanel>
                            <!-- 分组卡片：音频输出 -->
                            <Border Padding="22,20"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    Width="620"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="音频输出"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#202124" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding OutputDeviceText}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="300" />
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0"
                                               Text="选择播放输出的设备与模式。独占模式下播放器独占所选设备，其他程序的声音会被静音，音质最佳；共享模式走 Windows 混音器，可与其他程序同时出声。"
                                               Foreground="#6B7280"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />

                                    <!-- 输出模式：独占 / 共享 分段选择 -->
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="输出模式"
                                                   Foreground="#202124"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,18,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton GroupName="OutputModeGroup"
                                                         Content="WASAPI 独占"
                                                         FontSize="13"
                                                         Foreground="#202124"
                                                         Margin="0,0,22,0"
                                                         VerticalAlignment="Center"
                                                         Cursor="Hand"
                                                         IsChecked="{Binding SelectedOutputMode, Mode=TwoWay, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static vm:OutputMode.Exclusive}}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border x:Name="Bullet"
                                                                    Width="16"
                                                                    Height="16"
                                                                    CornerRadius="8"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="#C9CDD4"
                                                                    BorderThickness="1.5"
                                                                    Margin="0,0,7,0"
                                                                    VerticalAlignment="Center">
                                                                <Ellipse x:Name="Dot"
                                                                         Width="8"
                                                                         Height="8"
                                                                         Fill="#E4533C"
                                                                         Visibility="Collapsed" />
                                                            </Border>
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Bullet" Property="BorderBrush" Value="#E4533C" />
                                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bullet" Property="BorderBrush" Value="#9AA3AF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                            <RadioButton GroupName="OutputModeGroup"
                                                         Content="共享"
                                                         FontSize="13"
                                                         Foreground="#202124"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Cursor="Hand"
                                                         IsChecked="{Binding SelectedOutputMode, Mode=TwoWay, Converter={StaticResource EnumMatchConverter}, ConverterParameter={x:Static vm:OutputMode.Shared}}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border x:Name="Bullet"
                                                                    Width="16"
                                                                    Height="16"
                                                                    CornerRadius="8"
                                                                    Background="#FFFFFF"
                                                                    BorderBrush="#C9CDD4"
                                                                    BorderThickness="1.5"
                                                                    Margin="0,0,7,0"
                                                                    VerticalAlignment="Center">
                                                                <Ellipse x:Name="Dot"
                                                                         Width="8"
                                                                         Height="8"
                                                                         Fill="#E4533C"
                                                                         Visibility="Collapsed" />
                                                            </Border>
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Bullet" Property="BorderBrush" Value="#E4533C" />
                                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bullet" Property="BorderBrush" Value="#9AA3AF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 输出设备：下拉选择 + 刷新按钮 -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="输出设备"
                                                   Foreground="#202124"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,18,0" />
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource SettingsComboBoxStyle}"
                                                  Height="34"
                                                  ItemsSource="{Binding OutputDevices}"
                                                  SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  VerticalAlignment="Center" />
                                        <!-- 刷新设备列表：插拔音频设备后点击重新枚举 -->
                                        <Button Grid.Column="2"
                                                Width="34"
                                                Height="34"
                                                Margin="8,0,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="刷新设备列表"
                                                VerticalAlignment="Center"
                                                Click="RefreshOutputDevices_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="#F1F2F4" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="#E9EBEF" />
                                                            <Setter TargetName="Root" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform Y="1" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4,7.58 4,12 C 4,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 Z"
                                                  Fill="#9AA3AF"
                                                  Width="15"
                                                  Height="15"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <!-- 当前生效提示：模式 + 设备名，与侧栏指示一致 -->
                                    <TextBlock Margin="0,14,0,0"
                                               Text="切换输出设备或模式后立即生效：正在播放的歌曲会自动用新的输出重新加载。"
                                               Foreground="#9CA3AF"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 分组卡片：API 服务 -->
                            <Border Padding="22,20"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    Width="620">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="API 服务"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#202124" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Border Padding="10,4"
                                                    Background="#E8F5E9"
                                                    CornerRadius="6">
                                                <TextBlock Text="{Binding ApiCurrentServerText}"
                                                           Foreground="#2E7D32"
                                                           FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0"
                                               Text="程序运行需要网易云音乐 API 服务。默认使用本机启动的 NeteaseMusic-API（localhost:3000），也可以填写云端部署的 API 地址（例如 Vercel 部署的地址）。"
                                               Foreground="#6B7280"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />
                                    <!-- 地址输入行：网址图标 + 输入框 + 测试 + 保存 -->
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE774;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#9AA3AF"
                                                   FontSize="16"
                                                   Width="26"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" />
                                        <TextBox Grid.Column="1"
                                                 Margin="0,0,10,0"
                                                 Height="36"
                                                 Padding="10,4"
                                                 VerticalContentAlignment="Center"
                                                 Foreground="#202124"
                                                 Background="#F5F6F8"
                                                 BorderBrush="#E5E7EB"
                                                 BorderThickness="1"
                                                 FontSize="13"
                                                 Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 TextOptions.TextFormattingMode="Ideal">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#E4533C" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Height="36"
                                                MinWidth="88"
                                                Padding="14,0"
                                                Margin="0,0,8,0"
                                                IsEnabled="{Binding ApiCanTest}"
                                                Click="TestApiConnection_Click">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="测试连接" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ApiBusy}" Value="True">
                                                                <Setter Property="Text" Value="测试中…" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Grid.Column="3"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Height="36"
                                                MinWidth="88"
                                                Padding="14,0"
                                                IsEnabled="{Binding ApiCanSave}"
                                                Click="SaveApiBaseUrl_Click">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="保存" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ApiBusy}" Value="True">
                                                                <Setter Property="Text" Value="保存中…" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </Grid>
                                    <!-- 结果提示：成功绿 / 失败红 / 空闲灰 -->
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding ApiConnectionStatus}"
                                               Foreground="#6B7280"
                                               FontSize="12"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApiStatusIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#D6453F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 自动启动本地 API 开关：控制播放器启动时是否自动拉起本地服务 -->
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Text="自动启动本地 API"
                                                       Foreground="#202124"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <ToggleButton Style="{StaticResource SettingsToggleSwitchStyle}"
                                                          IsChecked="{Binding AutoStartLocalApi, Mode=TwoWay}"
                                                          ToolTip="关闭后播放器不再自动拉起本地 API，也不自动切换端口" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,8,0,0"
                                               Text="开启时启动播放器会自动拉起内置 API（3000 端口被占用会自动换端口）；若你想手动管理 API 服务或改用其他方式启动，可关闭此选项。"
                                               Foreground="#9CA3AF"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <!-- 操作说明 -->
                                    <TextBlock Margin="0,12,0,0"
                                               Text="先点「测试连接」确认地址可用，再点「保存」应用。保存后搜索、播放、收藏等请求都会发往该服务器；同一账号的登录状态会跟随迁移。"
                                               Foreground="#9CA3AF"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#22272E">
            <Grid Margin="18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 进度条行 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding PositionText}"
                               Foreground="#9AA3AF"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Width="36"
                               TextAlignment="Center" />

                    <Slider Grid.Column="1"
                            x:Name="ProgressSlider"
                            Style="{StaticResource RoundedSliderStyle}"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding PositionRatio, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            IsSnapToTickEnabled="False"
                            TickFrequency="0.001"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Thumb.DragStarted="ProgressSlider_DragStarted"
                            Thumb.DragCompleted="ProgressSlider_DragCompleted"
                            ValueChanged="ProgressSlider_ValueChanged" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationText}"
                               Foreground="#9AA3AF"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Width="36"
                               TextAlignment="Center" />
                </Grid>

                <!-- 控制按钮行 -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <!-- 上一首（用户 SVG） -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="PreviousButton_Click"
                                ToolTip="上一首">
                            <Path Width="16"
                                  Height="16"
                                  Fill="#9AA3AF"
                                  Stretch="Uniform"
                                  Data="M803.584 134.592c-18.176-10.048-39.936-10.112-58.112 0L192 443.008l0-282.88c0-17.664-14.336-32-32-32S128 142.464 128 160.128l0 344.896C127.744 507.2 127.104 509.248 127.104 511.488S127.744 515.84 128 518.016l0 346.112c0 17.664 14.336 32 32 32s32-14.336 32-32L192 579.968l553.408 308.352C754.56 893.44 764.48 896 774.528 896s19.968-2.56 29.056-7.616c18.176-10.112 28.992-28.224 28.992-48.576L832.576 183.104C832.576 162.88 821.76 144.768 803.584 134.592zM768.192 829.248 198.016 511.488 771.328 192 768.192 829.248z" />
                        </Button>
                        <!-- 播放/暂停（突出） -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="PlayPauseButton_Click"
                                ToolTip="{Binding PlayPauseButtonText}">
                            <TextBlock Text="{Binding PlayPauseIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#9AA3AF"
                                       FontSize="20"
                                       VerticalAlignment="Center" />
                        </Button>
                        <!-- 下一首（用户 SVG） -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="NextButton_Click"
                                ToolTip="下一首">
                            <Path Width="16"
                                  Height="16"
                                  Fill="#9AA3AF"
                                  Stretch="Uniform"
                                  Data="M832 160.128c0-17.664-14.336-32-32-32S768 142.464 768 160.128l0 282.88L214.592 134.592c-18.176-10.112-39.936-10.048-58.112 0C138.24 144.768 127.424 162.88 127.424 183.168l0 656.64c0 20.224 10.816 38.464 29.056 48.576C165.568 893.44 175.488 896 185.472 896s19.968-2.56 29.056-7.616L768 579.968l0 284.096c0 17.664 14.336 32 32 32s32-14.336 32-32L832 160.128zM191.808 829.248 188.672 192l573.312 319.488L191.808 829.248z" />
                        </Button>
                        <!-- 循环模式：顺序/单曲用 MDL2，随机用用户 SVG -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="CyclePlaybackMode_Click"
                                ToolTip="{Binding PlaybackModeText}">
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <TextBlock Text="&#xE8EE;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="#9AA3AF"
                                                           FontSize="16" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlaybackMode}"
                                                         Value="RepeatOne">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <TextBlock Text="&#xE8ED;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="#9AA3AF"
                                                                   FontSize="16" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PlaybackMode}"
                                                         Value="Shuffle">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Path Width="16"
                                                              Height="16"
                                                              Fill="#9AA3AF"
                                                              Stretch="Uniform"
                                                              Data="M768 763.008V682.666667l213.333333 128-213.333333 128v-89.173334a384 384 0 0 1-298.538667-228.906666L469.333333 620.373333l-0.128 0.256A384 384 0 0 1 116.266667 853.333333H85.333333v-85.333333h30.933334a298.666667 298.666667 0 0 0 274.517333-181.034667L422.912 512l-32.128-74.965333A298.666667 298.666667 0 0 0 116.266667 256H85.333333V170.666667h30.933334a384 384 0 0 1 352.938666 232.746666L469.333333 403.626667l0.128-0.256A384 384 0 0 1 768 174.506667V85.333333l213.333333 128-213.333333 128V260.992a298.666667 298.666667 0 0 0-220.117333 176.042667L515.754667 512l32.128 74.965333A298.666667 298.666667 0 0 0 768 763.008z" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="22,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <!-- 当前歌曲缩略图（圆角：双层 Border + ImageBrush，Image 不被圆角裁剪） -->
                        <Grid Width="48"
                              Height="48"
                              Margin="0,0,12,0">
                            <Border Background="#2E343C"
                                    CornerRadius="8" />
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CurrentSongCoverUrl}"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSongText}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding StatusText}"
                                       Foreground="#9AA3AF"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 停止（放在音质左边，防误触）+ 音质选择 + 音量控制 -->
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <!-- 红心：喜欢当前歌曲（收藏到「我喜欢的音乐」）。
                             未喜欢 = 灰色心形（红心收藏前图标），已喜欢 = 主题红（红心收藏后图标）。
                             两个 SVG 几何相同，仅填充色不同，用一个 Path 按 CurrentSongLiked 切换 Fill。 -->
                        <Button Style="{StaticResource HeartButtonStyle}"
                                Click="ToggleLiked_Click"
                                ToolTip="{Binding LikedToolTip}">
                            <Path Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Data="M853.2 259.3c-24.1-38.2-58.7-66.3-99.9-81.1-43.8-15.8-92.1-16.1-139.8-0.9-40.6 13-78.5 36.7-110.7 69.2-31.1-32.6-68.1-56.4-108.2-69.6-47-15.4-95.1-15.5-139.1-0.2-42.2 14.7-77.6 42.7-102.5 81.2-26.8 41.4-40.4 92.5-40.4 151.9 0 84.8 32.7 166.4 97.2 242.4 62.7 73.9 157.4 144.5 281.5 210 3.6 1.9 7.4 2.8 11.2 2.8 8.6 0 16.9-4.7 21.2-12.8 6.2-11.7 1.7-26.2-10-32.4C394.9 757 305 690.2 246.3 621c-28.7-33.8-50.4-68.8-64.6-104.1-14-34.8-21.1-70.9-21.1-107.3 0-49.9 11-92.2 32.7-125.8 19-29.4 46-50.8 78-61.9 34-11.8 71.5-11.7 108.4 0.5 39.5 13 75.4 38.9 104 75l18.4 23.2 18.9-22.8c30.1-36.2 67.2-62.1 107.2-74.9 37.5-12 75.2-11.8 108.9 0.3 31.1 11.2 57.3 32.5 75.6 61.6 21 33.2 31.6 75.2 31.6 124.7 0 21.4-2.4 42.7-7.3 63.5-3 12.9 5 25.8 18 28.8 12.9 3 25.8-5 28.8-18 5.6-24.3 8.5-49.3 8.5-74.3 0-58.5-13.2-109.1-39.1-150.2z M721.9 531.2c-13.3 0-24 10.7-24 24V813c0 13.3 10.7 24 24 24s24-10.7 24-24V555.2c0-13.3-10.7-24-24-24zM612.2 658c-13.3 0-24 10.7-24 24v131.3c0 13.3 10.7 24 24 24s24-10.7 24-24V682c0-13.3-10.8-24-24-24zM831.7 621.7c-13.3 0-24 10.7-24 24v167.6c0 13.3 10.7 24 24 24s24-10.7 24-24V645.7c0-13.3-10.8-24-24-24z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#9AA3AF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSongLiked}" Value="True">
                                                <Setter Property="Fill" Value="#E4533C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- 收藏：弹出小框选择自己创建的歌单加入。
                             图标 = 添加音乐（music note + 右下角 + 徽章，8 段路径合并）。 -->
                        <Button x:Name="CollectButton"
                                Style="{StaticResource CollectButtonStyle}"
                                Click="CollectButton_Click"
                                ToolTip="收藏到歌单">
                            <Path Width="18"
                                  Height="18"
                                  Fill="#9AA3AF"
                                  Stretch="Uniform"
                                  Data="M369.066667 928c-221.44 0-315.733333-94.293333-315.733334-315.733333v-243.2c0-221.44 94.293333-315.733333 315.733334-315.733334h243.2c221.44 0 315.733333 94.293333 315.733333 315.733334v243.2c0 15.36-0.426667 29.866667-1.28 43.946666-0.853333 12.8-9.386667 23.893333-21.76 28.16-12.373333 4.266667-25.6 0.426667-34.56-8.96-25.6-29.013333-63.146667-46.08-102.826667-46.08-76.373333 0-138.666667 62.293333-138.666666 138.666667 0 25.173333 6.826667 49.92 20.053333 71.253333 6.826667 11.946667 15.786667 22.613333 26.026667 31.573334 9.813333 8.533333 13.653333 22.186667 9.386666 34.133333-4.266667 12.373333-15.36 20.906667-28.16 21.76-13.653333 0.853333-28.16 1.28-43.946666 1.28h-243.2z m-251.733334-558.933333v243.2c0 186.026667 65.706667 251.733333 251.733334 251.733333h220.586666a200.533333 200.533333 0 0 1-24.32-96c0-111.786667 90.88-202.666667 202.666667-202.666667 34.133333 0 66.986667 8.533333 96 23.893334V369.066667c0-186.026667-65.706667-251.733333-251.733333-251.733334h-243.2c-186.026667 0-251.733333 65.706667-251.733334 251.733334z M192.853333 553.386667c0-51.626667 42.24-93.866667 93.866667-93.866667 51.626667 0 93.866667 42.24 93.866667 93.866667 0 51.626667-42.24 93.866667-93.866667 93.866666-51.626667 0-93.866667-42.24-93.866667-93.866666z m64 0c0 16.213333 13.226667 29.866667 29.866667 29.866666 16.64 0 29.866667-13.226667 29.866667-29.866666 0-16.64-13.226667-29.866667-29.866667-29.866667-16.213333 0-29.866667 13.226667-29.866667 29.866667z M316.586667 553.386667V304.64c0-38.826667 24.32-70.4 61.44-80.64l123.733333-33.706667c38.4-10.666667 62.72-0.426667 75.946667 9.813334 13.226667 10.24 29.44 30.72 29.44 70.4V512c0 17.493333-14.506667 32-32 32s-32-14.506667-32-32V270.506667c0-13.653333-2.986667-18.773333-4.266667-19.626667-1.28-0.853333-7.253333-2.56-20.48 0.853333l-123.306667 33.706667c-12.8 3.413333-14.506667 12.373333-14.506666 18.773333v248.746667c0 17.92-14.506667 32.426667-32 32.426667s-32-14.506667-32-32z M41