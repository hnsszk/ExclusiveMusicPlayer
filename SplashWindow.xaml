<Window x:Class="ExclusiveMusicPlayer.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网易云播放器" Width="360" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True">
    <Border Background="#FDFDFD" CornerRadius="16" Padding="28">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar Width="120" Height="6" IsIndeterminate="True"
                         Foreground="#EC4141" Background="#E8E8E8" BorderThickness="0" />
            <TextBlock Text="正在启动本地 API…" Margin="0,18,0,0"
                       FontSize="14" Foreground="#333333" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="首次启动可能稍慢" Margin="0,8,0,0"
                       FontSize="12" Foreground="#999999" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
